        videoSnapTitle: '🎬 Clip Vidéo (Toucher pour Ouvrir)',
        textTitle: '💬 Message Texte (Toucher pour Ouvrir)',
        tapToExpandText: 'Toucher pour ouvrir le texte complet et fermer à tout moment',
        dictate: 'Dicter',
        send: 'Envoyer',
        placeholder: 'Dictez ou écrivez un message à votre cercle...',
      },
    };

    const state = {
      lang: 'en',
      offline: false,
      userName: 'Leonard J. Lee',
      circleId: 'LW-MKE-01',
      recording: false,
      recSec: 0,
      recTimer: null,
      videoPlaying: false,
      videoSec: 0,
      videoMaxSec: 12,
      videoTimer: null,
      roomLive: false,
      voiceBursts: [
        { sender: 'Dad (Leonard)', time: '15s ago', dur: '00:09' },
        { sender: 'Grandson (Leo Jr.)', time: '3m ago', dur: '00:06' },
      ],
      texts: [
        { sender: 'Aunt Maya', time: '12m ago', body: 'On my way home now, traffic is moving steady along I-94. 👍' },
      ],
    };

    function applyLanguage(lang) {
      state.lang = lang;
      const t = I18N[lang] || I18N.en;
      document.documentElement.lang = lang;
      document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';

      document.getElementById('t-appName').textContent = t.appName;
      document.getElementById('t-e2eeBadge').textContent = t.e2eeBadge;
      document.getElementById('t-videoRoom').textContent = t.videoRoom;
      document.getElementById('t-langLabel').textContent = t.langLabel;
      document.getElementById('t-setupTitle').textContent = t.setupTitle;
      document.getElementById('t-setupDesc').textContent = t.setupDesc;
      document.getElementById('t-walkieTitle').textContent = t.walkieTitle;
      document.getElementById('t-videoSnapTitle').textContent = t.videoSnapTitle;
      document.getElementById('t-textTitle').textContent = t.textTitle;
      document.getElementById('t-tapToExpandText').textContent = t.tapToExpandText;
      document.getElementById('t-dictate').textContent = t.dictate;
      document.getElementById('t-send').textContent = t.send;
      document.getElementById('textInput').placeholder = t.placeholder;
      if (!state.recording) {
        document.getElementById('pttBtn').textContent = t.holdToTalk;
      }
    }

    function renderVoices() {
      const list = document.getElementById('voiceList');
      list.innerHTML = '';
      state.voiceBursts.slice(0, 3).forEach((b) => {
        const row = document.createElement('div');
        row.className = 'item-row';
        row.innerHTML = `<div><strong>${b.sender}</strong><div class="item-meta">${b.time} · E2EE</div></div><span>▶ ${b.dur}</span>`;
        list.appendChild(row);
      });
    }

    function renderLatestText() {
      const latest = state.texts[0];
      if (!latest) return;
      document.getElementById('latestTextSender').textContent = `${latest.sender} · ${latest.time}`;
      document.getElementById('latestTextBody').textContent = latest.body;
      document.getElementById('latestTextBadge').textContent = `${state.texts.length} msg`;
    }

    function renderFullTextModal() {
      const container = document.getElementById('fullTextList');
      container.innerHTML = '';
      state.texts.forEach((m) => {
        const div = document.createElement('div');
        div.className = 'item-row';
        div.innerHTML = `<div style="width:100%;"><strong>${m.sender}</strong> <span class="item-meta">· ${m.time}</span><div style="margin-top:4px;">${m.body}</div></div>`;
        container.appendChild(div);
      });
    }

    // Top-right language switcher
    document.getElementById('langSelect').addEventListener('change', (e) => {
      applyLanguage(e.target.value);
    });

    // Status toggle
    document.getElementById('statusBtn').addEventListener('click', () => {
      state.offline = !state.offline;
      document.getElementById('statusDot').classList.toggle('offline', state.offline);
      document.getElementById('statusText').textContent = state.offline ? 'Queued Offline' : 'All Good';
    });

    // Circle select
    document.getElementById('circleSelect').addEventListener('change', (e) => {
      state.circleId = e.target.value;
      document.getElementById('activeCircleCode').textContent = state.circleId;
      document.getElementById('setupCircleInput').value = state.circleId;
      document.getElementById('roomCircleReadout').textContent = `Circle: ${state.circleId}`;
    });

    // PTT hold & release
    const pttBtn = document.getElementById('pttBtn');
    function startRec() {
      if (state.recording) return;
      state.recording = true;
      state.recSec = 1;
      pttBtn.classList.add('recording');
      pttBtn.textContent = `${I18N[state.lang].talking} 00:01`;
      state.recTimer = setInterval(() => {
        state.recSec += 1;
        const mm = String(Math.floor(state.recSec / 60)).padStart(2, '0');
        const ss = String(state.recSec % 60).padStart(2, '0');
        pttBtn.textContent = `${I18N[state.lang].talking} ${mm}:${ss}`;
      }, 1000);
    }
    function stopRec() {
      if (!state.recording) return;
      state.recording = false;
      clearInterval(state.recTimer);
      const dur = `00:${String(Math.max(1, state.recSec)).padStart(2, '0')}`;
      pttBtn.classList.remove('recording');
      pttBtn.textContent = I18N[state.lang].holdToTalk;
      state.voiceBursts.unshift({ sender: `${state.userName} (You)`, time: 'Just now', dur });
      renderVoices();
    }
    pttBtn.addEventListener('mousedown', startRec);
    window.addEventListener('mouseup', () => { if (state.recording) stopRec(); });
    pttBtn.addEventListener('touchstart', (e) => { e.preventDefault(); startRec(); }, { passive: false });
    window.addEventListener('touchend', () => { if (state.recording) stopRec(); });

    // Voice dictation into the single text input
    document.getElementById('dictateBtn').addEventListener('click', () => {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      const input = document.getElementById('textInput');
      if (!SR) {
        input.focus();
        return;
      }
      const rec = new SR();
      rec.lang = state.lang;
      rec.onresult = (ev) => {
        const spoken = ev.results?.[0]?.[0]?.transcript || '';
        if (spoken) input.value = input.value ? `${input.value} ${spoken}` : spoken;
      };
      rec.start();
    });

    // Emoji toggle
    document.getElementById('emojiBtn').addEventListener('click', () => {
      document.getElementById('emojiBar').classList.toggle('open');
    });
    document.getElementById('emojiBar').addEventListener('click', (e) => {
      if (e.target.classList.contains('emoji-chip')) {
        const input = document.getElementById('textInput');
        input.value += e.target.textContent;
        input.focus();
      }
    });

    // Send text message
    document.getElementById('textForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('textInput');
      const val = input.value.trim();
      if (!val) return;
      state.texts.unshift({ sender: `${state.userName} (You)`, time: 'Just now', body: val });
      input.value = '';
      renderLatestText();
    });

    // Modal helpers
    const openModal = (id) => document.getElementById(id).classList.add('open');
    const closeModal = (id) => document.getElementById(id).classList.remove('open');

    // Video Snap modal
    document.getElementById('videoPreviewCard').addEventListener('click', () => openModal('videoModal'));
    document.getElementById('closeVideoModal').addEventListener('click', () => {
      clearInterval(state.videoTimer);
      state.videoPlaying = false;
      closeModal('videoModal');
    });
    document.getElementById('toggleVideoPlayBtn').addEventListener('click', () => {
      if (state.videoPlaying) {
        clearInterval(state.videoTimer);
        state.videoPlaying = false;
        return;
      }
      state.videoPlaying = true;
      state.videoTimer = setInterval(() => {
        state.videoSec += 1;
        if (state.videoSec > state.videoMaxSec) {
          state.videoSec = 0;
          clearInterval(state.videoTimer);
          state.videoPlaying = false;
        }
        document.getElementById('videoPlayTimer').textContent = `00:${String(state.videoSec).padStart(2, '0')} / 00:12`;
      }, 1000);
    });
    document.getElementById('saveSnapBtn').addEventListener('click', () => {
      const blob = new Blob([JSON.stringify({ app: 'LeeWay Global P2P', circleId: state.circleId, clip: 'Lakefront Shoreline Snap', e2ee: true }, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'leeway-video-snap.json';
      a.click();
      URL.revokeObjectURL(url);
    });

    // Text modal
    document.getElementById('textPreviewCard').addEventListener('click', () => {
      renderFullTextModal();
      openModal('textModal');
    });
    document.getElementById('closeTextModal').addEventListener('click', () => closeModal('textModal'));

    // Setup modal
    document.getElementById('openSetupBtn').addEventListener('click', () => openModal('setupModal'));
    document.getElementById('closeSetupModal').addEventListener('click', () => closeModal('setupModal'));
    document.getElementById('dismissSetupBtn').addEventListener('click', () => {
      document.getElementById('setupStrip').style.display = 'none';
    });
    document.getElementById('saveSetupBtn').addEventListener('click', () => {
      state.userName = document.getElementById('setupNameInput').value.trim() || 'Leonard J. Lee';
      state.circleId = document.getElementById('setupCircleInput').value.trim() || 'LW-MKE-01';
      document.getElementById('activeCircleCode').textContent = state.circleId;
      document.getElementById('roomCircleReadout').textContent = `Circle: ${state.circleId}`;
      closeModal('setupModal');
    });

    // Opt-in Private Video Room modal
    document.getElementById('openVideoRoomBtn').addEventListener('click', () => openModal('roomModal'));
    document.getElementById('closeRoomModal').addEventListener('click', () => closeModal('roomModal'));
    document.getElementById('toggleRoomSessionBtn').addEventListener('click', () => {
      state.roomLive = !state.roomLive;
      document.getElementById('roomStatusHeadline').textContent = state.roomLive
        ? `Live Private Video Session (${state.circleId})`
        : 'Standby — Tap Start for Live Room';
    });

    renderVoices();
    renderLatestText();
  </script>
</body>
</html>