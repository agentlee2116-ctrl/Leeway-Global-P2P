<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LeeWay Global P2P</title>
  <style>
    :root {
      --bg: #070b12;
      --panel: #0e1522;
      --panel-2: #141e30;
      --border: #23324d;
      --text: #eef3fb;
      --muted: #93a4be;
      --accent: #f59e0b;
      --accent-2: #38bdf8;
      --ok: #22c55e;
      --warn: #eab308;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    .app-shell {
      max-width: 980px;
      margin: 0 auto;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* Top Bar with consistent right-side Language Switcher */
    .top-bar {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 10px 14px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .brand-title {
      font-weight: 800;
      font-size: 1rem;
      letter-spacing: 0.02em;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      border: 1px solid var(--border);
      background: var(--panel-2);
    }

    .badge.e2ee {
      border-color: rgba(34, 197, 94, 0.45);
      color: #86efac;
    }

    .status-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 5px 11px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--panel-2);
      color: var(--text);
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
    }

    .dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--ok);
      box-shadow: 0 0 8px rgba(34, 197, 94, 0.8);
    }

    .dot.offline {
      background: var(--warn);
      box-shadow: 0 0 8px rgba(234, 179, 8, 0.8);
    }

    .top-right-controls {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-left: auto;
    }

    .lang-box {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 4px 8px;
      font-size: 0.78rem;
    }

    select, input, button {
      font-family: inherit;
    }

    select {
      background: var(--panel);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 5px 8px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .btn {
      border: 1px solid var(--border);
      background: var(--panel-2);
      color: var(--text);
      border-radius: 10px;
      padding: 7px 12px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.08s ease, background 0.15s ease;
    }

    .btn:hover { background: #1d2b44; }
    .btn:active { transform: scale(0.98); }

    .btn.primary {
      background: var(--accent);
      color: #0b0e14;
      border-color: transparent;
    }

    .btn.video-room {
      background: rgba(56, 189, 248, 0.14);
      border-color: rgba(56, 189, 248, 0.45);
      color: #bae6fd;
    }

    /* Setup Banner so onboarding is always visible until completed */
    .setup-strip {
      background: linear-gradient(90deg, rgba(245, 158, 11, 0.12), rgba(56, 189, 248, 0.1));
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 10px 14px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .setup-text {
      font-size: 0.84rem;
      color: var(--text);
    }

    .setup-text span {
      color: var(--muted);
      font-size: 0.78rem;
      display: block;
      margin-top: 2px;
    }

    /* Divided 3-Part Walkie-Talkie Workspace */
    .workspace-grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 12px;
    }

    @media (max-width: 780px) {
      .workspace-grid { grid-template-columns: 1fr; }
    }

    .card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 0.84rem;
      font-weight: 800;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    /* Voice Walkie-Talkie Section */
    .ptt-zone {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .ptt-big-btn {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: none;
      background: var(--accent);
      color: #090c12;
      font-size: 1rem;
      font-weight: 900;
      letter-spacing: 0.04em;
      cursor: pointer;
      user-select: none;
    }

    .ptt-big-btn.recording {
      background: #ef4444;
      color: #fff;
    }

    .feed-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .item-row {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 9px 11px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 0.84rem;
    }

    .item-meta {
      color: var(--muted);
      font-size: 0.75rem;
    }

    /* Video & Text Click-to-Expand Sections */
    .clickable-preview {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .clickable-preview:hover {
      border-color: var(--accent-2);
    }

    .video-thumb {
      height: 112px;
      border-radius: 9px;
      background: linear-gradient(135deg, #0f2942, #132238);
      border: 1px solid rgba(56, 189, 248, 0.3);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px;
    }

    .text-preview-box {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px;
      cursor: pointer;
      font-size: 0.86rem;
    }

    .text-preview-box:hover {
      border-color: var(--accent);
    }

    /* Single Composer with Voice Dictation + Emojis */
    .composer {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .composer-row {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .composer-row input {
      flex: 1;
      background: var(--panel-2);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 9px 12px;
      font-size: 0.9rem;
    }

    .emoji-bar {
      display: none;
      flex-wrap: wrap;
      gap: 6px;
      padding-top: 4px;
    }

    .emoji-bar.open {
      display: flex;
    }

    .emoji-chip {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 4px 8px;
      font-size: 1rem;
      cursor: pointer;
    }

    /* Expandable Modal / Pop-up Drawer */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(3, 6, 12, 0.78);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 14px;
      z-index: 50;
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal-box {
      width: 100%;
      max-width: 540px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-height: 88vh;
      overflow-y: auto;
    }

    .modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .modal-title {
      font-size: 1rem;
      font-weight: 800;
    }

    .video-stage {
      height: 220px;
      border-radius: 12px;
      background: radial-gradient(circle at top, #173654, #090e17);
      border: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <!-- TOP BAR: Circle, E2EE, Status, Private Video Room, and Top-Right Language Switcher -->
    <header class="top-bar">
      <div class="brand-group">
        <span class="brand-title" id="t-appName">LeeWay Global P2P</span>
        <span class="badge e2ee" id="t-e2eeBadge">🔒 E2EE Secured</span>
        <button type="button" class="status-btn" id="statusBtn">
          <span class="dot" id="statusDot"></span>
          <span id="statusText">All Good</span>
        </button>
        <select id="circleSelect" aria-label="Family Circle">
          <option value="LW-MKE-01">Milwaukee Family (LW-MKE-01)</option>
          <option value="LW-GLB-08">Global Family (LW-GLB-08)</option>
          <option value="LW-UKG-03">UK & Gulf Circle (LW-UKG-03)</option>
        </select>
      </div>

      <div class="top-right-controls">
        <button type="button" class="btn video-room" id="openVideoRoomBtn">
          <span id="t-videoRoom">Private Video Room</span>
        </button>
        <label class="lang-box" for="langSelect">
          <span id="t-langLabel">🌐 Language:</span>
          <select id="langSelect">
            <option value="en">English (EN)</option>
            <option value="es">Español (ES)</option>
            <option value="ar">العربية (AR)</option>
            <option value="zh">中文 (ZH)</option>
            <option value="fr">Français (FR)</option>
          </select>
        </label>
      </div>
    </header>

    <!-- SETUP STRIP: Clear device & family circle onboarding -->
    <section class="setup-strip" id="setupStrip">
      <div class="setup-text">
        <strong id="t-setupTitle">Device & Family Circle Setup</strong>
        <span id="t-setupDesc">Step 1: Create local keys & save app · Step 2: Join or create your private circle ID · Step 3: Send walkie-talkie voice, video snaps, or text.</span>
      </div>
      <div style="display:flex; gap:8px;">
        <button type="button" class="btn primary" id="openSetupBtn">Set Up / Circle ID</button>
        <button type="button" class="btn" id="dismissSetupBtn">✓</button>
      </div>
    </section>

    <!-- DIVIDED WORKSPACE: Walkie-Talkie Voice on Left, Video Snap + Text on Right -->
    <main class="workspace-grid">
      <!-- Walkie-Talkie Voice Section -->
      <section class="card">
        <div class="card-header">
          <span id="t-walkieTitle">🎙️ Walkie-Talkie Voice</span>
          <span id="activeCircleCode">LW-MKE-01</span>
        </div>

        <div class="ptt-zone">
          <button type="button" class="ptt-big-btn" id="pttBtn">HOLD TO TALK</button>
          <div class="item-meta" id="pttHint">Hold button or Spacebar to send a walkie-talkie voice burst (no call ring).</div>
        </div>

        <div class="feed-list" id="voiceList"></div>
      </section>

      <!-- Video Snap & Text Section (click each to expand, then close) -->
      <div style="display:flex; flex-direction:column; gap:12px;">
        <section class="card">
          <div class="card-header">
            <span id="t-videoSnapTitle">🎬 Video Snap (Tap to Open)</span>
            <button type="button" class="btn" id="newSnapBtn">+ Snap</button>
          </div>
          <div class="clickable-preview" id="videoPreviewCard">
            <div class="video-thumb">
              <div>
                <div style="font-weight:800;" id="snapPreviewTitle">Lakefront Shoreline Snap</div>
                <div class="item-meta" id="snapPreviewMeta">Grandson (Leo Jr.) · 00:12 · Tap to expand & play</div>
              </div>
              <span class="btn primary">▶ Open</span>
            </div>
          </div>
        </section>

        <section class="card">
          <div class="card-header">
            <span id="t-textTitle">💬 Text Dispatch (Tap to Open)</span>
            <span class="item-meta" id="latestTextBadge">1 new</span>
          </div>
          <div class="text-preview-box" id="textPreviewCard">
            <div style="font-weight:700;" id="latestTextSender">Aunt Maya</div>
            <div id="latestTextBody" style="margin-top:4px;">On my way home now, traffic is moving steady along I-94. 👍</div>
            <div class="item-meta" style="margin-top:6px;" id="t-tapToExpandText">Tap to open full text thread & close anytime</div>
          </div>
        </section>
      </div>
    </main>

    <!-- SINGLE TEXT INPUT WITH VOICE DICTATION & EMOJIS -->
    <section class="composer">
      <form class="composer-row" id="textForm">
        <button type="button" class="btn" id="dictateBtn" title="Voice Dictation">🎤 <span id="t-dictate">Dictate</span></button>
        <button type="button" class="btn" id="emojiBtn" title="Emojis">😊</button>
        <input type="text" id="textInput" placeholder="Speak or type a message to your family circle..." autocomplete="off" />
        <button type="submit" class="btn primary" id="t-send">Send</button>
      </form>
      <div class="emoji-bar" id="emojiBar">
        <button type="button" class="emoji-chip">👍</button>
        <button type="button" class="emoji-chip">❤️</button>
        <button type="button" class="emoji-chip">🙏</button>
        <button type="button" class="emoji-chip">🚗</button>
        <button type="button" class="emoji-chip">✅</button>
        <button type="button" class="emoji-chip">👋</button>
        <button type="button" class="emoji-chip">📍</button>
      </div>
    </section>
  </div>

  <!-- EXPANDABLE POP-UP 1: VIDEO SNAP PLAYER & SAVE -->
  <div class="modal-backdrop" id="videoModal">
    <div class="modal-box">
      <div class="modal-head">
        <div class="modal-title" id="videoModalTitle">Video Snap</div>
        <button type="button" class="btn" id="closeVideoModal">✕ Close</button>
      </div>
      <div class="video-stage">
        <div style="font-size:1.1rem; font-weight:800;" id="videoStageLabel">Lakefront Shoreline Snap</div>
        <div class="item-meta" id="videoStageSub">Encrypted clip · Ready for playback or local save</div>
        <div id="videoPlayTimer" style="font-weight:800; color:var(--accent-2);">00:00 / 00:12</div>
      </div>
      <div style="display:flex; gap:8px; justify-content:flex-end;">
        <button type="button" class="btn primary" id="toggleVideoPlayBtn">▶ Play / Pause</button>
        <button type="button" class="btn" id="saveSnapBtn">⬇ Save Clip</button>
      </div>
    </div>
  </div>

  <!-- EXPANDABLE POP-UP 2: TEXT DISPATCH VIEWER (closes cleanly back down) -->
  <div class="modal-backdrop" id="textModal">
    <div class="modal-box">
      <div class="modal-head">
        <div class="modal-title" id="textModalTitle">Circle Text Dispatches</div>
        <button type="button" class="btn" id="closeTextModal">✕ Close</button>
      </div>
      <div class="feed-list" id="fullTextList"></div>
    </div>
  </div>

  <!-- EXPANDABLE POP-UP 3: SETUP & CIRCLE ID -->
  <div class="modal-backdrop" id="setupModal">
    <div class="modal-box">
      <div class="modal-head">
        <div class="modal-title" id="setupModalTitle">Set Up Identity & Private Circle ID</div>
        <button type="button" class="btn" id="closeSetupModal">✕ Close</button>
      </div>
      <div class="item-meta">Your device creates local keys and joins a private circle ID without self-hosting a server.</div>
      <label class="item-meta">Display Name</label>
      <input type="text" id="setupNameInput" value="Leonard J. Lee" style="background:var(--panel-2); color:var(--text); border:1px solid var(--border); border-radius:8px; padding:8px;" />
      <label class="item-meta">Private Circle ID</label>
      <input type="text" id="setupCircleInput" value="LW-MKE-01" style="background:var(--panel-2); color:var(--text); border:1px solid var(--border); border-radius:8px; padding:8px;" />
      <div style="display:flex; gap:8px; justify-content:flex-end;">
        <button type="button" class="btn primary" id="saveSetupBtn">Save Setup</button>
      </div>
    </div>
  </div>

  <!-- EXPANDABLE POP-UP 4: OPT-IN PRIVATE VIDEO ROOM -->
  <div class="modal-backdrop" id="roomModal">
    <div class="modal-box">
      <div class="modal-head">
        <div class="modal-title" id="roomModalTitle">Private Video Room (Opt-In)</div>
        <button type="button" class="btn" id="closeRoomModal">✕ Close</button>
      </div>
      <div class="item-meta">Live multi-party video is optional when family members are online together. Walkie-talkie clips and offline queues stay active separately.</div>
      <div class="video-stage">
        <div style="font-weight:800;" id="roomStatusHeadline">Standby — Tap Start for Live Room</div>
        <div class="item-meta" id="roomCircleReadout">Circle: LW-MKE-01</div>
      </div>
      <div style="display:flex; gap:8px; justify-content:flex-end;">
        <button type="button" class="btn primary" id="toggleRoomSessionBtn">Start Video Session</button>
      </div>
    </div>
  </div>

